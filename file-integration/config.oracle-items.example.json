{
  "protocolVersion": 1,
  "sourceFormat": "oracle-items-v1",
  "requireReady": false,
  "stableSeconds": 60,
  "ftp": {
    "host": "FTP_HOST_REPLACE_ME",
    "port": 21,
    "inbox": "/ITEM_INBOX_REPLACE_ME",
    "tls": false,
    "allowPlainFtp": true,
    "usernameEnv": "MES_FTP_USER",
    "passwordEnv": "MES_FTP_PASSWORD"
  },
  "mes": {
    "baseUrl": "http://MES_TEST_GATEWAY_REPLACE_ME/api/integration"
  },
  "oracleItems": {
    "inventoryBaseUrl": "http://MES_TEST_INVENTORY_REPLACE_ME",
    "companyId": 0,
    "warehouseId": 0,
    "itemTypeMappingFile": "/var/lib/cwms-oracle-items/item-type-mapping.json",
    "mapping": {
      "companyCode": "COMPANY_CODE_REPLACE_ME",
      "warehouseName": "WAREHOUSE_NAME_REPLACE_ME",
      "itemTypeMapping": {"01": "Finish Good"},
      "cartonUnit": "CS",
      "unitMeasurements": {
        "piece": {"length": 1, "width": 1, "height": 1, "weight": 1},
        "carton": {"length": 1, "width": 1, "height": 1, "weight": 1},
        "pallet": {"length": 1, "width": 1, "height": 1, "weight": 1}
      },
      "unitOptions": {
        "piece": {
          "defaultForInboundReceiving": false,
          "defaultForWorkOrderReceiving": false,
          "trackingLpn": false,
          "defaultForDisplay": false,
          "caseFlag": false
        },
        "carton": {
          "defaultForInboundReceiving": false,
          "defaultForWorkOrderReceiving": false,
          "trackingLpn": false,
          "defaultForDisplay": false,
          "caseFlag": false
        },
        "pallet": {
          "defaultForInboundReceiving": true,
          "defaultForWorkOrderReceiving": true,
          "trackingLpn": true,
          "defaultForDisplay": true,
          "caseFlag": true
        }
      }
    }
  },
  "settingsApi": {
    "authBaseUrl": "http://MES_TEST_AUTH_REPLACE_ME",
    "userBaseUrl": "http://MES_TEST_RESOURCE_REPLACE_ME",
    "bind": "127.0.0.1",
    "port": 18790
  },
  "stateDirectory": "/var/lib/cwms-oracle-items/state",
  "pollSeconds": 60
}
